    <string name="routes_sac_1_name">Hiking</string>
    <string name="routes_sac_1_text">Well-built path, flat or slightly steep. No fall risk. Trainers are enough.</string>
    <string name="routes_sac_2_name">Mountain hiking</string>
    <string name="routes_sac_2_text">Continuous path, steep in places, fall risk not excluded. Some sure-footedness; hiking boots recommended.</string>
    <string name="routes_sac_3_name">Demanding mountain hiking</string>
    <string name="routes_sac_3_text">Path not always visible; exposed places may have ropes or chains; hands sometimes needed for balance. Sure-footed, good hiking boots.</string>
    <string name="routes_sac_4_name">Alpine hiking</string>
    <string name="routes_sac_4_text">Path not always present; hands needed in places; exposed terrain, steep grass, scree, easy snow fields. Experience in exposed terrain.</string>
    <string name="routes_sac_5_name">Demanding alpine hiking</string>
    <string name="routes_sac_5_text">Often without path; easy climbing (up to grade II); very exposed terrain. Mountaineering experience needed.</string>

