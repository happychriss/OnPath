    <string name="routes_sac_1_name">Wandern</string>
    <string name="routes_sac_1_text">Gut angelegter Weg, flach oder leicht geneigt. Keine Absturzgefahr. Turnschuhe genügen.</string>
    <string name="routes_sac_2_name">Bergwandern</string>
    <string name="routes_sac_2_text">Durchgehender Weg, teilweise steil, Absturzgefahr nicht ausgeschlossen. Etwas Trittsicherheit; Wanderschuhe empfohlen.</string>
    <string name="routes_sac_3_name">Anspruchsvolles Bergwandern</string>
    <string name="routes_sac_3_text">Weg nicht immer sichtbar; ausgesetzte Stellen evtl. mit Seilen oder Ketten gesichert; Hände manchmal fürs Gleichgewicht nötig. Trittsicher, gute Wanderschuhe.</string>
    <string name="routes_sac_4_name">Alpinwandern</string>
    <string name="routes_sac_4_text">Weg nicht immer vorhanden; stellenweise Hände nötig; ausgesetztes Gelände, steile Grashalden, Geröll, einfache Schneefelder. Erfahrung in ausgesetztem Gelände.</string>
    <string name="routes_sac_5_name">Anspruchsvolles Alpinwandern</string>
    <string name="routes_sac_5_text">Oft weglos; einfache Kletterstellen (bis II. Grad); sehr ausgesetztes Gelände. Bergsteigerische Erfahrung nötig.</string>

