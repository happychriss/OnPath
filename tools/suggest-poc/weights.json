{
  "version": "2026-11-13f",
  "_about": "Every knob of the tour-suggestions POC. Read again on every request – edit, save, press 'Vorschläge' again. 'activities.<name>' overrides any section below for that activity. Tune against bench.py, not by eye.",

  "simple": {
    "_about": "The page's few controls -> the numbers the engine works with. A level sets the taste slider(s); natur = forest + natural ground.",
    "levels": {"niedrig": 0.2, "mittel": 0.5, "hoch": 0.9},
    "natur_natural_factor": 0.7,
    "wasser_on": 0.9,
    "wasser_off": 0.25,
    "effort": {"leicht": "relaxed", "mittel": "medium", "sportlich": "sporty"}
  },

  "generator": {
    "_about": "Fan of loops around the start: directions x shapes; each loop is routed leg by leg, resized until its time fits. Then loops through the destinations in reach (attractions).",
    "directions": 12,
    "shapes": ["dreieck", "viereck", "keule"],
    "detour_factor": 1.35,
    "fit_iterations": 2,
    "fit_tolerance": 0.08,
    "via_jitter": 0.12,
    "back_penalty": 20,
    "taste_pass": true,
    "good_point_from": 0.7,
    "snap_max_factor": 0.8,
    "max_targets": 8,
    "target_reach_factor": 0.42,
    "target_snap_factor": 2.0,
    "leg_timeout_ms": 8000,
    "threads": 8
  },

  "attractions": {
    "_about": "Destinations: named lakes, known signed routes, viewpoints (attractions.py – POC: Overpass online, cached; phone: the map area's own files). rank = how much a route's network counts.",
    "enabled": true,
    "cache_grid_deg": 0.05,
    "max_reach_m": 6000,
    "lake_min_shore_m": 600,
    "timeout_s": 25,
    "tries": 1,
    "retry_after_s": 300,
    "rank": {"iwn": 1.0, "nwn": 1.0, "rwn": 0.85, "lwn": 0.6, "icn": 1.0, "ncn": 1.0, "rcn": 0.85, "lcn": 0.5, "": 0.4}
  },

  "routing": {
    "_about": "Profile parameters derived from the wish. A taste slider at or above 'from' switches the profile option on. mainroad_penalty (hike, POC addition – service/make_profiles.py) = base + per_quiet x Ruhe.",
    "profile": "hiking-mountain",
    "consider_forest_from": 0.5,
    "consider_noise_from": 0.5,
    "consider_river_from": 0.5,
    "consider_town_from": 0.5,
    "hiking_routes_preference_base": 0.3,
    "hiking_routes_preference_per_signed": 0.8,
    "mainroad_penalty_base": 1.0,
    "mainroad_penalty_per_quiet": 3.0,
    "avoid_unsafe_from": 0.8,
    "stick_to_cycleroutes_from": 2.0,
    "relaxed_considers_elevation": true,
    "extra_kv": {}
  },

  "time": {
    "_about": "hours = km / pace + ascent_m / ascent_m_per_h",
    "ascent_m_per_h": 500
  },

  "effort": {
    "_about": "ascent per km: 'max' = full points up to here, zero at 3 x max; 'min' = full points from here",
    "relaxed": {"max_m_per_km": 12},
    "medium": {"max_m_per_km": 35},
    "sporty": {"min_m_per_km": 25}
  },

  "classes": {
    "_about": "How way tags become values. forest/noise/river/town = BRouter's estimated_*_class (none, 1..6). Way kinds: G = along a main road (the road itself, or a pavement / cycle path beside it), S = quiet street, W = way near forest, P = other way.",
    "forest_value": {"": 0.0, "1": 0.05, "2": 0.15, "3": 0.3, "4": 0.5, "5": 0.8, "6": 1.0},
    "forest_share_from_class": 5,
    "forest_on_street_factor": 0.3,
    "noise_value": {"": 0.0, "1": 0.15, "2": 0.3, "3": 0.5, "4": 0.7, "5": 0.85, "6": 1.0},
    "loud_from_class": 4,
    "river_value": {"": 0.0, "1": 0.2, "2": 0.35, "3": 0.5, "4": 0.7, "5": 0.85, "6": 1.0},
    "street_highways": ["motorway", "trunk", "primary", "secondary", "tertiary", "unclassified", "residential",
                        "living_street", "service", "primary_link", "secondary_link", "tertiary_link", "trunk_link"],
    "big_highways": ["trunk", "primary", "secondary", "tertiary", "primary_link", "secondary_link", "tertiary_link", "trunk_link"],
    "sidewalk_is_street": true,
    "sidewalk_main_from_noise": 3,
    "cycleway_main_from_noise": 4,
    "lit_town_path_is_street": false,
    "main_gap_m": 40,
    "signed_prefixes": ["route_hiking_", "route_foot_"],
    "paved_surfaces": ["asphalt", "paved", "concrete", "paving_stones", "sett", "cobblestone", "concrete:plates", "concrete:lanes"]
  },

  "score": {
    "_about": "Each part is 0..1; score = weighted mean x 100. Taste parts (forest, quiet, water, signed, natural) are multiplied by the wish slider (0..1). mainroad = the longest continuous stretch along a main road: full points up to main_road_max_m, zero at main_road_zero_factor x that.",
    "weights": {
      "length": 2.0,
      "ascent": 1.0,
      "forest": 5.0,
      "quiet": 2.0,
      "water": 3.0,
      "signed": 2.5,
      "natural": 1.5,
      "street": 3.5,
      "mainroad": 3.0,
      "doubled": 3.0,
      "shape": 0.5,
      "crossings": 0.5
    },
    "length_zero_at": 0.35,
    "street_zero_at": 0.6,
    "big_street_counts": 1.0,
    "main_road_max_m": 300,
    "main_road_zero_factor": 2.5,
    "doubled_zero_at": 0.35,
    "shape_full_at": 0.35,
    "crossings_zero_per_km": 3.0,
    "signed_full_at": 0.6,
    "lake_full_m": 1000
  },

  "select": {
    "_about": "Best first; skipped: a candidate that shares more than max_shared of its length with an already chosen one, or whose time is more than max_length_off away from the wish.",
    "show": 5,
    "max_length_off": 0.2,
    "max_shared": 0.5
  },

