From d552a34356042196d478988a9622b91621307bd7 Mon Sep 17 00:00:00 2001
From: development <pmsfriend@googlemail.com>
Date: Wed, 18 Nov 2026 22:38:41 +0100
Subject: [PATCH] E2E: nightly on main, before a release and on demand instead
 of on every push; the full run on 4 emulators side by side
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Owner 2026-11-18 (architecture plan phase 0a): the full run took 45–85 min and was cancelled by the next push, so on a
busy day it never finished. Now: a nightly run (skipped when only docs / the planner changed since the last night),
dispatch by hand (tools/ci/e2e_github.sh; before a release the full run), release.yml's start test as before.
The full run uses the test runner's numShards=4 / shardIndex on four emulators; a run with a tests list keeps one.
Reports are named e2e-report-<shard> (tools/ci/e2e_github.sh reads every e2e-report* since the commit before).

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
---
 .github/workflows/e2e.yml     | 54 ++++++++++++++++++++++++++---------
 .github/workflows/release.yml |  2 +-
 2 files changed, 42 insertions(+), 14 deletions(-)

diff --git a/.github/workflows/e2e.yml b/.github/workflows/e2e.yml
index 0e4804296..cb8a65b93 100644
--- a/.github/workflows/e2e.yml
+++ b/.github/workflows/e2e.yml
@@ -1,18 +1,18 @@
 # End-to-end tests of the core features (docs/core-features.md) on an Android emulator: the real app and map,
 # a finger held on the screen (app/src/androidTest). Owner: "not good to find out during walking".
 #
-# Runs on every push to main that touches the app and by hand (owner: beside releases, not as a gate) – without the
-# Release-Rundgang (that runs locally on donald before a release made there: tools/ci/release_rundgang.sh,
-# docs/release-rundgang.md); release.yml calls it with only StartSmokeE2ETest as its gate. The screenshots (/sdcard/e2e)
-# are always in the report "e2e-report". A requested test class that produced no test case fails the run.
+# Runs every night on main (only when main changed in the last day), before a release and by hand – no longer on
+# every push (owner 2026-11-18: the 45–85 min run was cancelled by the next push and never finished on a busy day).
+# The full run is split over 4 emulators side by side (the test runner's numShards / shardIndex); a run with a `tests`
+# list (one class on demand: tools/ci/e2e_github.sh --tests …; release.yml: only StartSmokeE2ETest as its gate) uses one
+# emulator. Without the Release-Rundgang (that runs locally on donald before a release made there:
+# tools/ci/release_rundgang.sh, docs/release-rundgang.md). The screenshots (/sdcard/e2e) are always in the report
+# "e2e-report-<shard>". A requested test class that produced no test case fails the run.
 name: E2E
 
 on:
-  push:
-    branches: [main]
-    paths:
-      - "app/**"
-      - ".github/workflows/e2e.yml"
+  schedule:
+    - cron: "17 1 * * *" # 02:17 / 03:17 in Germany – after the day's pushes
   workflow_dispatch:
     inputs:
       tests:
@@ -33,9 +33,37 @@ concurrency:
   cancel-in-progress: false
 
 jobs:
+  # The nightly run is skipped when nothing but docs / the planner changed on main since the last night.
+  changed:
+    runs-on: ubuntu-latest
+    timeout-minutes: 5
+    outputs:
+      run: ${{ steps.look.outputs.run }}
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          fetch-depth: 200
+      - id: look
+        env:
+          EVENT: ${{ github.event_name }}
+        run: |
+          n=1
+          if [ "$EVENT" = schedule ]; then
+            n=$(git log --since='25 hours ago' --format=%h -- . ':(exclude)docs' ':(exclude)web' ':(exclude)*.md' | wc -l)
+          fi
+          echo "commits that can change the app: $n"
+          [ "$n" -gt 0 ] && echo "run=true" >> "$GITHUB_OUTPUT" || echo "run=false" >> "$GITHUB_OUTPUT"
+
   emulator:
+    needs: changed
+    if: needs.changed.outputs.run == 'true'
     runs-on: ubuntu-latest
-    timeout-minutes: 45
+    timeout-minutes: 40
+    strategy:
+      fail-fast: false
+      matrix:
+        # a `tests` list runs on one emulator, the full run on four
+        shard: ${{ fromJSON(inputs.tests != '' && '[0]' || '[0, 1, 2, 3]') }}
     steps:
       - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
 
@@ -110,11 +138,11 @@ jobs:
           script: |
             adb logcat -c || true
             adb push rd5/E10_N45.rd5 /data/local/tmp/E10_N45.rd5 && adb shell chmod 644 /data/local/tmp/E10_N45.rd5 || true
-            ./gradlew --no-daemon connectedDebugAndroidTest -Ponpath.e2e=true ${{ inputs.tests != '' && format('-Pandroid.testInstrumentationRunnerArguments.class={0}', inputs.tests) || '-Pandroid.testInstrumentationRunnerArguments.notClass=com.onpath.app.e2e.ReleaseRundgang' }} && R=0 || R=1; mkdir -p e2e-out; adb pull /sdcard/e2e e2e-out/ || true; [ $R = 0 ] || { adb logcat -d > e2e-out/logcat.txt || true; exit 1; }
+            ./gradlew --no-daemon connectedDebugAndroidTest -Ponpath.e2e=true ${{ inputs.tests != '' && format('-Pandroid.testInstrumentationRunnerArguments.class={0}', inputs.tests) || format('-Pandroid.testInstrumentationRunnerArguments.notClass=com.onpath.app.e2e.ReleaseRundgang -Pandroid.testInstrumentationRunnerArguments.numShards=4 -Pandroid.testInstrumentationRunnerArguments.shardIndex={0}', matrix.shard) }} && R=0 || R=1; mkdir -p e2e-out; adb pull /sdcard/e2e e2e-out/ || true; [ $R = 0 ] || { adb logcat -d > e2e-out/logcat.txt || true; exit 1; }
 
       # Guard: 0.13.3's release asked for "StartSmokeE2ETest,ReleaseRundgang", only the start test ran and the job was
       # green (docs/release-rundgang.md). Every requested class (or Class#method) must show up in the JUnit XML with at
-      # least one test case; without a list (push run, notClass) at least one test case at all.
+      # least one test case; without a list (full run, notClass) at least one test case in every shard.
       - name: Every requested test class ran
         env:
           TESTS: ${{ inputs.tests }}
@@ -142,7 +170,7 @@ jobs:
         if: always()
         uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
         with:
-          name: e2e-report
+          name: e2e-report-${{ matrix.shard }}
           path: |
             app/build/reports/androidTests/
             app/build/outputs/androidTest-results/
diff --git a/.github/workflows/release.yml b/.github/workflows/release.yml
index a179512f2..30b0bb516 100644
--- a/.github/workflows/release.yml
+++ b/.github/workflows/release.yml
@@ -32,7 +32,7 @@ concurrency:
   cancel-in-progress: false
 
 jobs:
-  # Owner decisions: the full emulator suite (e2e.yml) runs beside the release on every push to main (not waited for);
+  # Owner decisions: the full emulator suite (e2e.yml) runs every night and by hand before a release (not waited for here);
   # before publishing only the short start test (the app opens, also with a saved plan). The Release-Rundgang is not
   # run here (owner 2026-10-31, docs/release-rundgang.md): a release made on donald runs it locally first
   # (tools/ci/release_rundgang.sh), a release from elsewhere goes out without it. Unit tests below. Smoke and build run
-- 
2.53.0

