[Unit]
Description=OnPath map server worker (builds queued regions one at a time)
After=network-online.target
Wants=network-online.target

[Service]
User=onpath
Group=onpath
WorkingDirectory=@SRV@
Environment=ONPATH_HOME=@HOME@ ONPATH_REPO=@REPO@ PATH=@VENV@/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=@VENV@/bin/python -m onpath_maps.worker run
Restart=always
RestartSec=10
Nice=10
NoNewPrivileges=yes
ProtectSystem=full

[Install]
WantedBy=multi-user.target
