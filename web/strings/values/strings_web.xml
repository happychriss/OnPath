    <!-- Help & credits -->
    <string name="web_about_title">OnPath planner</string>
    <string name="web_about_text">The OnPath app's own planning code in your browser. Your plan stays in the link and, once saved, in this browser (and on your paired phone, end-to-end encrypted). No account.</string>
    <string name="web_about_how">How to plan</string>
    <string name="web_about_how_1">Click the map to set the start, then the destination and stops; click a point for its menu.</string>
    <string name="web_about_how_2">Search a place, then add it from its card. Drag ≡ in Points to change the order.</string>
    <string name="web_about_how_3">Undo / redo, the eye (hold: hide the route) and Map content are in the toolbar at the top.</string>
    <string name="web_about_how_4">Send to phone: a QR code the OnPath app scans – or pair the phone once and save plans to My plans.</string>
    <string name="web_credit_photon">Search online: Photon by komoot (OpenStreetMap data)</string>
    <string name="web_credit_maplibre">Map renderer: MapLibre GL JS (BSD licence)</string>
