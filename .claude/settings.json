{
  "permissions": {
    "allow": [
      "mcp__claude-code-remote__send_message",
      "mcp__claude-code-remote__list_sessions",
      "mcp__claude-code-remote__get_session",
      "mcp__claude-code-remote__list_events",
      "mcp__claude-code-remote__get_event",
      "Bash(tools/ask.sh *)",
      "Bash(tools/ci/gate.sh)",
      "Bash(tools/ci/gate.sh *)",
      "Bash(tools/ci/release_check.sh *)",
      "Bash(tools/dev/device.sh *)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git fetch *)",
      "Bash(git pull --rebase origin main)",
      "Bash(gh api repos/happychriss/*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git push * --force*)",
      "Bash(git reset --hard*)",
      "Bash(git reset * --hard*)",
      "Bash(git branch -D *)",
      "Bash(git push origin --delete *)",
      "Bash(git push --delete *)",
      "Bash(git checkout -- .)",
      "Bash(git clean -f*)",
      "Bash(adb uninstall*)",
      "Bash(adb * uninstall*)",
      "Bash(adb shell pm clear*)",
      "Bash(adb * shell pm clear*)",
      "Bash(adb shell pm uninstall*)",
      "Bash(./gradlew --stop*)",
      "Bash(gradle --stop*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/tools/hooks/session-start.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/tools/hooks/pre-bash.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/tools/hooks/stop-wake.sh",
            "asyncRewake": true,
            "timeout": 3600
          }
        ]
      }
    ]
  }
}
